# ---------------------------------------------------------------------------
# WordPress backend (Phase 2)
# ---------------------------------------------------------------------------

# Base URL of the live WordPress + JetEngine backend (no trailing slash).
# The frontend fetches REST endpoints under ${WP_API_URL}/wp-json/...
# Server-side only — never exposed to the browser (no NEXT_PUBLIC_ prefix).
# Defaults to https://panel.trabajo.com.py if left unset.
WP_API_URL=https://panel.trabajo.com.py

# Source switch. When set to exactly "true", the site reads jobs/companies/
# taxonomies from the live WordPress backend (lib/wp.ts). Any other value
# (unset, "false", ...) falls back to the bundled seed JSON in lib/seed/*.
# Leave OFF until real jobs exist in WordPress; flip to "true" in Hostinger.
USE_WP_BACKEND=false
