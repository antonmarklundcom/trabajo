# ---------------------------------------------------------------------------
# Custom MySQL backend (Phase A+)
# ---------------------------------------------------------------------------

# Data source switch: "seed" | "db". Any other value (including unset) falls
# back to "seed", so a half-configured deploy never accidentally serves an
# empty database. Set to "db" only after running migrations +
# scripts/seed-import.ts against DATABASE_URL (MIGRATION.md).
DATA_SOURCE=seed

# mysql://user:pass@host:3306/dbname — see DEPLOY.md for Hostinger specifics
# (remote host differs from the "localhost" the live app uses).
DATABASE_URL=

# iron-session cookie encryption key for the /admin session cookie. Must be
# >= 32 characters — iron-session refuses to start below that, and lib/auth.ts
# fails with a clearer message pointing here. Generate with:
#   openssl rand -base64 32
#
# Required only for /admin. The public site runs without it.
#
# Rotating it invalidates every existing admin session (everyone is logged out)
# but does NOT touch passwords — those are bcrypt hashes in the users table.
# Rotate it if the value ever leaks. As with DATABASE_URL, hPanel holds the
# production value and the app must be redeployed after changing it.
SESSION_SECRET=

# The same secret seals BOTH session cookies: `trabajo_session` (admin, editor,
# employer) and `trabajo_postulante` (candidates). They are separate cookies
# holding different payloads, and each side rejects the other's — see the `kind`
# discriminator in lib/auth-candidate.ts. Rotating it logs everyone out of both.

# ---------------------------------------------------------------------------
# Phase 2 feature flags (PLAN-PHASE2.md §6)
# ---------------------------------------------------------------------------
# Both default to OFF. Anything other than the exact string "true" is off,
# including unset — forgetting to configure a variable must never be the same
# as choosing to enable a route tree. While a flag is off, its routes return
# 404, so the tree is indistinguishable from one that does not exist.
#
# These are read server-side only. Do NOT add a NEXT_PUBLIC_ variant: a
# client-visible flag is a hint to the browser, not a gate.

# /empresa/* — employer dashboard. Flip to true in PR 6, after the Spanish
# terms/privacy copy for employers has shipped.
EMPLOYER_DASHBOARD_ENABLED=false

# /postulante/* — candidate accounts, CVs, one-click apply. Flip to true in
# PR 11, after the consent and privacy copy has shipped AND the retention
# period has been confirmed. Storing a CV without that copy in place is the one
# thing in this project that is a legal problem rather than a bug.
CANDIDATE_ACCOUNTS_ENABLED=false

# ---------------------------------------------------------------------------
# CV storage (PLAN-PHASE2.md §3.1)
# ---------------------------------------------------------------------------
# Required as soon as CANDIDATE_ACCOUNTS_ENABLED is true — a candidate account
# without somewhere to put a CV is half a feature. There is deliberately NO
# default: falling back to disk because someone typo'd "r2 " would write CVs
# into a directory the next deploy deletes, and nobody would notice until a
# candidate asked for their file back.
#
# Which one to pick is open question Q4. R2 is the recommendation: a private
# bucket costs approximately nothing at this volume, it survives a deploy, and
# it is a bucket rather than a service to operate.
CV_STORAGE_DRIVER=

# --- driver "r2" (Cloudflare R2, S3-compatible) ---
# The bucket must be PRIVATE with no public access and no custom public domain.
# Downloads are 60-second presigned URLs generated per request by lib/storage.ts
# and never stored — there is no public URL for a CV, ever.
#
# Create an R2 API token scoped to Object Read & Write on this one bucket. A
# token with account-wide access is a token that can read every other bucket
# from a web process.
CV_R2_ACCOUNT_ID=
CV_R2_BUCKET=
CV_R2_ACCESS_KEY_ID=
CV_R2_SECRET_ACCESS_KEY=
# Optional. Defaults to https://{CV_R2_ACCOUNT_ID}.r2.cloudflarestorage.com,
# which is what Cloudflare issues; set it only for an S3-compatible endpoint
# that is not R2 (a local MinIO, for example).
CV_R2_ENDPOINT=
# Optional. R2 ignores the region, but SigV4 signs it, so it has to match on
# both sides. "auto" is what Cloudflare documents and is the default.
CV_R2_REGION=auto

# --- driver "disk" (Hostinger fallback) ---
# Absolute path, and it MUST be outside the build root: the deployed source
# lives under public_html/.builds/last-source/ and is replaced on every deploy
# (DEPLOY.md), so anything written inside the app directory is destroyed by the
# next merge to main. Something like /home/<user>/cv-storage.
#
# Nothing on the Hostinger side backs this directory up on our schedule, so
# picking this driver comes with a manual backup step (Q4).
CV_STORAGE_DIR=

# ---------------------------------------------------------------------------
# Public image storage (PLAN-IMAGES.md)
# ---------------------------------------------------------------------------
# The shared pipeline behind company logos, blog images and job-posting images.
# Required as soon as any feature that uploads an image is live; until then the
# site runs without it (nothing calls the module).
#
# Note what this is NOT: it is the *public* store. Everything in it is served
# without a session check, by design. CVs have their own module, their own
# driver variables (CV_STORAGE_* above) and their own authorized routes — the
# two must never be pointed at the same directory or bucket.
#
# "disk" | "r2". No default, for the same reason CV_STORAGE_DRIVER has none: a
# typo must fail loudly instead of quietly writing somewhere wrong.
#
# **Use "disk".** The decision and its reasoning are in PLAN-IMAGES.md §2 —
# short version: images are re-uploadable (unlike a CV), so the durability
# argument that made R2 the CV recommendation does not apply, and a public R2
# bucket needs a Cloudflare-hosted custom domain that a few hundred logos do not
# justify. Switching later is an env var plus a file copy, because the database
# stores the storage KEY and never the URL.
IMAGE_STORAGE_DRIVER=disk

# --- driver "disk" (default) ---
# Absolute path, and it MUST be outside the build root — same trap as
# CV_STORAGE_DIR: the deployed source lives under
# public_html/.builds/last-source/ and is replaced on every deploy, so anything
# written inside the app directory (including public/) is destroyed by the next
# merge to main. Something like /home/<user>/image-storage.
#
# The images are served by app/img/[...key]/route.ts, not as static files —
# there is no static directory that survives a deploy.
IMAGE_STORAGE_DIR=

# --- driver "r2" (Cloudflare R2, S3-compatible) ---
# The bucket must be PUBLIC-READ — the opposite of the CV bucket, which is why
# it is a different bucket and not a prefix in the same one. Uploads and deletes
# are still SigV4-signed from the server; only reads are anonymous.
#
# Create an R2 API token scoped to Object Read & Write on this one bucket.
IMAGE_R2_ACCOUNT_ID=
IMAGE_R2_BUCKET=
IMAGE_R2_ACCESS_KEY_ID=
IMAGE_R2_SECRET_ACCESS_KEY=
# The bucket's public https:// origin — a custom domain on Cloudflare DNS.
# Required by the "r2" driver, which refuses to start without it. Cloudflare
# documents the r2.dev development domain as rate-limited and not for
# production, so it is not an answer here.
IMAGE_R2_PUBLIC_BASE_URL=
# Optional. Defaults to https://{IMAGE_R2_ACCOUNT_ID}.r2.cloudflarestorage.com.
IMAGE_R2_ENDPOINT=
# Optional. R2 ignores the region, but SigV4 signs it. "auto" is the default.
IMAGE_R2_REGION=auto

# ---------------------------------------------------------------------------
# Lead routing (optional — the site works with both left empty)
# ---------------------------------------------------------------------------
# Each accepted lead (employer post + job-seeker application) is normalised into
# one flat snake_case JSON payload and POSTed in parallel to the destinations
# below, with 3× exponential-backoff retries each. A logger failure never fails
# the user's submission, and an empty value is skipped silently. Server-side
# only — never expose these to the browser (no NEXT_PUBLIC_ prefix).

# GoHighLevel inbound webhook. A SINGLE webhook receives BOTH lead types; tell
# them apart by the payload's `lead_type` ("employer" | "seeker") field.
# Create it in GHL → Automation → Workflows → "Inbound Webhook" trigger, then
# paste the generated URL here.
GHL_WEBHOOK_URL=

# Google Sheets sink. A Google Apps Script Web App (or Zapier/Make "Catch Hook")
# that accepts a POST with a JSON body and appends one row per lead. The flat
# payload keys map 1:1 to columns.
GOOGLE_SHEETS_WEBHOOK_URL=
