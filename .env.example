# ---------------------------------------------------------------------------
# Custom MySQL backend (Phase A+)
# ---------------------------------------------------------------------------

# Data source switch: "seed" | "db". Any other value (including unset) falls
# back to "seed", so a half-configured deploy never accidentally serves an
# empty database. Set to "db" only after running migrations +
# scripts/seed-import.ts against DATABASE_URL (MIGRATION.md).
DATA_SOURCE=seed

# mysql://user:pass@host:3306/dbname — see DEPLOY.md for Hostinger specifics
# (remote host differs from the "localhost" the live app uses).
DATABASE_URL=

# iron-session cookie encryption key for the /admin session cookie. Must be
# >= 32 characters — iron-session refuses to start below that, and lib/auth.ts
# fails with a clearer message pointing here. Generate with:
#   openssl rand -base64 32
#
# Required only for /admin. The public site runs without it.
#
# Rotating it invalidates every existing admin session (everyone is logged out)
# but does NOT touch passwords — those are bcrypt hashes in the users table.
# Rotate it if the value ever leaks. As with DATABASE_URL, hPanel holds the
# production value and the app must be redeployed after changing it.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Lead routing (optional — the site works with both left empty)
# ---------------------------------------------------------------------------
# Each accepted lead (employer post + job-seeker application) is normalised into
# one flat snake_case JSON payload and POSTed in parallel to the destinations
# below, with 3× exponential-backoff retries each. A logger failure never fails
# the user's submission, and an empty value is skipped silently. Server-side
# only — never expose these to the browser (no NEXT_PUBLIC_ prefix).

# GoHighLevel inbound webhook. A SINGLE webhook receives BOTH lead types; tell
# them apart by the payload's `lead_type` ("employer" | "seeker") field.
# Create it in GHL → Automation → Workflows → "Inbound Webhook" trigger, then
# paste the generated URL here.
GHL_WEBHOOK_URL=

# Google Sheets sink. A Google Apps Script Web App (or Zapier/Make "Catch Hook")
# that accepts a POST with a JSON body and appends one row per lead. The flat
# payload keys map 1:1 to columns.
GOOGLE_SHEETS_WEBHOOK_URL=
