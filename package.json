{
  "name": "trabajo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed-import.ts",
    "db:verify": "tsx --env-file-if-exists=.env scripts/verify-db.ts",
    "db:parity": "DATA_SOURCE=db tsx --env-file-if-exists=.env scripts/parity-check.ts",
    "db:purge": "tsx --conditions=react-server --env-file-if-exists=.env scripts/db-purge.ts",
    "user:create": "tsx --env-file-if-exists=.env scripts/create-user.ts",
    "user:password": "tsx --env-file-if-exists=.env scripts/set-password.ts",
    "candidate:create": "tsx --env-file-if-exists=.env scripts/create-candidate.ts",
    "db:verify-scoping": "tsx --conditions=react-server --env-file-if-exists=.env scripts/verify-scoping.ts",
    "storage:verify": "tsx --conditions=react-server --env-file-if-exists=.env scripts/verify-storage.ts",
    "image-storage:verify": "tsx --conditions=react-server --env-file-if-exists=.env scripts/verify-image-storage.ts",
    "retention:verify": "tsx scripts/verify-retention.ts",
    "access:verify": "tsx scripts/verify-candidate-access.ts",
    "cascade:verify": "tsx scripts/verify-cascades.ts",
    "blog:verify": "tsx --conditions=react-server scripts/verify-blog.ts"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "iron-session": "^8.0.4",
    "isomorphic-dompurify": "^3.22.0",
    "mysql2": "^3.23.2",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
